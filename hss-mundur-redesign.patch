+  --flame: #f2692c;
+
+  --paper: #fbf7ef;
+  --paper-2: #f4eddf;
+  --card: #ffffff;
+  --line: #e6dfcf;
+
+  --radius-sm: 12px;
+  --radius: 20px;
+  --radius-lg: 28px;
+
+  --shadow-sm: 0 1px 2px rgba(14, 36, 39, 0.06), 0 4px 14px rgba(14, 36, 39, 0.06);
+  --shadow-md: 0 2px 4px rgba(14, 36, 39, 0.06), 0 18px 40px rgba(14, 36, 39, 0.14);
+
+  --font-display: 'Fraunces', Georgia, 'Times New Roman', serif;
+  --font-body: 'Figtree', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
+    sans-serif;
+
+  --gutter: clamp(16px, 4.5vw, 32px);
+  --section: clamp(56px, 8vw, 104px);
+  --header-h: 64px;
+  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
+}
+
+@media (min-width: 900px) {
+  :root {
+    --header-h: 76px;
+  }
+}
+
+/* ── Reset & base ───────────────────────────────────────── */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+* {
+  margin: 0;
+}
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  scroll-padding-top: calc(var(--header-h) + 16px);
+  overflow-x: clip;
+}
+html.nav-open {
+  overflow: hidden;
+}
+@media (prefers-reduced-motion: no-preference) {
+  html {
+    scroll-behavior: smooth;
+  }
+}
+body {
+  min-height: 100vh;
+  min-height: 100dvh;
+  display: flex;
+  flex-direction: column;
+  font-family: var(--font-body);
+  font-size: 1rem;
+  line-height: 1.65;
+  color: var(--ink);
+  background: var(--paper);
+  -webkit-font-smoothing: antialiased;
+  -moz-osx-font-smoothing: grayscale;
+  overflow-x: clip;
+}
+main {
+  flex: 1 0 auto;
+}
+img,
+svg {
+  display: block;
+  max-width: 100%;
+}
+img {
+  height: auto;
+}
+a {
+  color: inherit;
+  text-decoration: none;
+}
+ul,
+ol {
+  list-style: none;
+  padding: 0;
+}
+button {
+  font: inherit;
+  color: inherit;
+  cursor: pointer;
+}
+p {
+  text-wrap: pretty;
+}
+h1,
+h2,
+h3,
+h4 {
+  font-family: var(--font-display);
+  font-weight: 600;
+  line-height: 1.12;
+  letter-spacing: -0.01em;
+  color: var(--teal-950);
+  text-wrap: balance;
+}
+h1 {
+  font-size: clamp(2.3rem, 1.4rem + 4.4vw, 4.4rem);
+  line-height: 1.04;
+}
+h2 {
+  font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.85rem);
+}
+h3 {
+  font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.4rem);
+}
+::selection {
+  background: var(--gold);
+  color: var(--teal-950);
+}
+:focus-visible {
+  outline: 3px solid var(--gold);
+  outline-offset: 3px;
+  border-radius: 6px;
+}
+.icon,
+.flame {
+  flex: none;
+}
+
+.container {
+  width: 100%;
+  max-width: calc(1180px + 2 * var(--gutter));
+  margin-inline: auto;
+  padding-left: max(var(--gutter), env(safe-area-inset-left));
+  padding-right: max(var(--gutter), env(safe-area-inset-right));
+}
+
+.skip-link {
+  position: fixed;
+  left: 12px;
+  top: -80px;
+  z-index: 300;
+  padding: 10px 16px;
+  border-radius: 10px;
+  background: var(--gold);
+  color: var(--teal-950);
+  font-weight: 700;
+}
+.skip-link:focus {
+  top: 12px;
+}
+
+/* ── Scroll progress ────────────────────────────────────── */
+.progress {
+  position: fixed;
+  inset: 0 0 auto 0;
+  height: 3px;
+  z-index: 100;
+  pointer-events: none;
+}
+.progress span {
+  display: block;
+  height: 100%;
+  background: linear-gradient(90deg, var(--gold), var(--flame));
+  transform-origin: 0 50%;
+  transform: scaleX(0);
+}
+
+/* ── Reveal on scroll (only when JS is running) ─────────── */
+.js [data-reveal] {
+  opacity: 0;
+  translate: 0 20px;
+  transition: opacity 0.7s var(--ease), translate 0.7s var(--ease);
+}
+.js [data-reveal].is-visible {
+  opacity: 1;
+  translate: 0 0;
+}
+.js .counter:not(.is-ready) {
+  visibility: hidden;
+}
+
+/* ── Buttons ────────────────────────────────────────────── */
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  min-height: 50px;
+  padding: 0 26px;
+  border: 2px solid transparent;
+  border-radius: 999px;
+  font-weight: 700;
+  font-size: 1rem;
+  line-height: 1;
+  white-space: nowrap;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform 0.2s var(--ease), background-color 0.2s, color 0.2s, border-color 0.2s,
+    box-shadow 0.2s;
+}
+.btn:active {
+  transform: scale(0.97);
+}
+.btn-gold {
+  background: var(--gold);
+  color: var(--teal-950);
+  box-shadow: 0 10px 24px rgba(232, 169, 53, 0.28);
+}
+.btn-ghost {
+  border-color: rgba(251, 247, 239, 0.4);
+  color: var(--paper);
+}
+.btn-outline {
+  border-color: var(--teal-900);
+  color: var(--teal-900);
+}
+@media (hover: hover) {
+  .btn:hover {
+    transform: translateY(-2px);
+  }
+  .btn:active {
+    transform: scale(0.97);
+  }
+  .btn-gold:hover {
+    background: #f1b84a;
+    box-shadow: 0 14px 30px rgba(232, 169, 53, 0.38);
+  }
+  .btn-ghost:hover {
+    background: rgba(251, 247, 239, 0.1);
+    border-color: var(--paper);
+  }
+  .btn-outline:hover {
+    background: var(--teal-900);
+    color: var(--paper);
+  }
+}
+.btn-row {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-top: 32px;
+}
+
+/* ── Type helpers ───────────────────────────────────────── */
+.eyebrow {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--teal-700);
+}
+.eyebrow::before {
+  content: '';
+  width: 28px;
+  height: 2px;
+  border-radius: 2px;
+  background: currentColor;
+}
+.eyebrow--light {
+  color: var(--gold);
+}
+.eyebrow--center {
+  justify-content: center;
+}
+.eyebrow--center::after {
+  content: '';
+  width: 28px;
+  height: 2px;
+  border-radius: 2px;
+  background: currentColor;
+}
+.hero .eyebrow::before,
+.notfound .eyebrow::before {
+  display: none;
+}
+.lead {
+  font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
+  line-height: 1.6;
+}
+.muted {
+  color: var(--muted);
+}
+.flame-sm {
+  width: 12px;
+  height: 17px;
+}
+.flame--lit {
+  transform-origin: 50% 100%;
+  animation: flicker 3.4s ease-in-out infinite;
+}
+@keyframes flicker {
+  0%,
+  100% {
+    transform: scale(1) rotate(0deg);
+  }
+  30% {
+    transform: scale(1.06, 1.1) rotate(-2deg);
+  }
+  60% {
+    transform: scale(0.97, 1.03) rotate(1.5deg);
+  }
+}
+
+/* ── Sections ───────────────────────────────────────────── */
+.section {
+  padding-block: var(--section);
+}
+.section--tint {
+  background: var(--paper-2);
+}
+.section--dark {
+  background: var(--teal-900);
+  color: var(--paper);
+}
+.section--dark h2 {
+  color: var(--paper);
+}
+.section-head {
+  max-width: 640px;
+  margin-bottom: clamp(28px, 4vw, 48px);
+}
+.section-head h2,
+.split-copy h2,
+.prose h2,
+.contact-grid h2 {
+  margin-top: 12px;
+}
+.section-head p:not(.eyebrow) {
+  margin-top: 14px;
+  font-size: 1.06rem;
+  color: var(--muted);
+}
+.section-head--center {
+  margin-inline: auto;
+  text-align: center;
+}
+
+/* ── Header ─────────────────────────────────────────────── */
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 60;
+  padding-top: env(safe-area-inset-top);
+  background: rgba(251, 247, 239, 0.97);
+  border-bottom: 1px solid transparent;
+  transition: border-color 0.25s, box-shadow 0.25s;
+}
+.site-header.is-scrolled {
+  border-color: var(--line);
+  box-shadow: 0 8px 24px rgba(14, 36, 39, 0.06);
+}
+.header-inner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  height: var(--header-h);
+  gap: 16px;
+}
+.brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+}
+.brand-mark {
+  flex: none;
+  width: 42px;
+  height: 42px;
+  display: grid;
+  place-items: center;
+  border-radius: 13px;
+  background: var(--teal-900);
+}
+.brand-mark .flame {
+  width: 16px;
+  height: 23px;
+}
+.brand-text {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.15;
+}
+.brand-name {
+  font-family: var(--font-display);
+  font-weight: 700;
+  font-size: 1.2rem;
+  letter-spacing: 0.02em;
+  color: var(--teal-950);
+}
+.brand-sub {
+  display: none;
+  font-size: 0.72rem;
+  font-weight: 500;
+  color: var(--muted);
+}
+@media (min-width: 380px) {
+  .brand-sub {
+    display: block;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+  }
+}
+
+.nav-toggle {
+  flex: none;
+  width: 48px;
+  height: 48px;
+  margin-right: -10px;
+  display: grid;
+  place-items: center;
+  border: 0;
+  border-radius: 14px;
+  background: transparent;
+  color: var(--teal-950);
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+}
+
+/* Mobile: full-screen menu sheet */
+.nav {
+  position: fixed;
+  inset: calc(var(--header-h) + env(safe-area-inset-top)) 0 0 0;
+  z-index: 59;
+  padding: 12px max(var(--gutter), env(safe-area-inset-left)) calc(32px + env(safe-area-inset-bottom));
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  background: var(--paper);
+  visibility: hidden;
+  opacity: 0;
+  transform: translateY(-8px);
+  transition: opacity 0.22s, transform 0.28s var(--ease), visibility 0s linear 0.28s;
+}
+.nav.is-open {
+  visibility: visible;
+  opacity: 1;
+  transform: none;
+  transition-delay: 0s;
+}
+.nav ul {
+  display: grid;
+}
+.nav a {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 18px 4px;
+  border-bottom: 1px solid var(--line);
+  font-family: var(--font-display);
+  font-size: 1.7rem;
+  font-weight: 600;
+  color: var(--teal-950);
+}
+.nav a[aria-current='page'] {
+  color: var(--teal-700);
+}
+.nav a[aria-current='page']::before {
+  content: '';
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--gold);
+}
+
+@media (min-width: 900px) {
+  .site-header {
+    -webkit-backdrop-filter: saturate(1.4) blur(12px);
+    backdrop-filter: saturate(1.4) blur(12px);
+    background: rgba(251, 247, 239, 0.86);
+  }
+  .brand-mark {
+    width: 46px;
+    height: 46px;
+  }
+  .nav-toggle {
+    display: none;
+  }
+  .nav {
+    position: static;
+    inset: auto;
+    padding: 0;
+    overflow: visible;
+    background: none;
+    visibility: visible;
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+  .nav ul {
+    display: flex;
+    gap: 4px;
+  }
+  .nav a {
+    padding: 10px 16px;
+    border: 0;
+    border-radius: 999px;
+    font-family: var(--font-body);
+    font-size: 0.97rem;
+    font-weight: 600;
+    color: var(--ink-2);
+    transition: background-color 0.2s, color 0.2s;
+  }
+  .nav a[aria-current='page'] {
+    background: var(--gold-100);
+    color: var(--teal-900);
+  }
+  .nav a[aria-current='page']::before {
+    display: none;
+  }
+  .nav a:hover {
+    background: var(--paper-2);
+    color: var(--teal-950);
+  }
+}
+
+/* ── Hero ───────────────────────────────────────────────── */
+.hero {
+  position: relative;
+  overflow: hidden;
+  color: var(--paper);
+  padding-top: clamp(36px, 7vw, 88px);
+  padding-bottom: clamp(36px, 5vw, 64px);
+  background-color: var(--teal-900);
+  background-image: radial-gradient(60% 55% at 85% 18%, rgba(232, 169, 53, 0.16), transparent 70%),
+    radial-gradient(55% 60% at 0% 100%, rgba(31, 138, 133, 0.35), transparent 70%),
+    radial-gradient(rgba(251, 247, 239, 0.07) 1px, transparent 1.5px);
+  background-size: auto, auto, 26px 26px;
+}
+.hero-glow {
+  position: absolute;
+  width: min(120vw, 900px);
+  aspect-ratio: 1;
+  right: -25%;
+  top: -30%;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(242, 105, 44, 0.22), rgba(232, 169, 53, 0.08) 45%, transparent 70%);
+  pointer-events: none;
+  animation: glow 6s ease-in-out infinite;
+}
+@keyframes glow {
+  0%,
+  100% {
+    opacity: 0.75;
+  }
+  50% {
+    opacity: 1;
+  }
+}
+.hero .container {
+  position: relative;
+}
+.hero-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: clamp(36px, 6vw, 64px);
+  align-items: center;
+}
+.hero h1 {
+  color: var(--paper);
+  margin-top: 18px;
+}
+.hero h1 em {
+  font-style: italic;
+  font-weight: 500;
+  color: var(--gold);
+}
+.hero .lead {
+  margin-top: 22px;
+  max-width: 34em;
+  color: rgba(251, 247, 239, 0.82);
+}
+
+.hero-figure {
+  position: relative;
+  width: min(100%, 300px);
+  margin: 6px auto 20px;
+}
+.hero-figure::before {
+  content: '';
+  position: absolute;
+  inset: -12px -12px 18px;
+  border: 1.5px solid rgba(232, 169, 53, 0.45);
+  border-radius: 999px 999px 30px 30px;
+  pointer-events: none;
+}
+.arch {
+  position: relative;
+  aspect-ratio: 4 / 5;
+  overflow: hidden;
+  border-radius: 999px 999px 24px 24px;
+  background: var(--teal-800);
+  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
+}
+.arch img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: 52% 40%;
+}
+.hero-chip {
+  position: absolute;
+  left: 50%;
+  bottom: -18px;
+  transform: translateX(-50%);
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 9px 16px;
+  border-radius: 999px;
+  background: var(--paper);
+  color: var(--teal-950);
+  font-size: 0.85rem;
+  font-weight: 700;
+  white-space: nowrap;
+  box-shadow: var(--shadow-md);
+}
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin-top: clamp(36px, 6vw, 72px);
+}
+.stat {
+  padding: 18px;
+  border: 1px solid rgba(251, 247, 239, 0.14);
+  border-radius: 18px;
+  background: rgba(251, 247, 239, 0.06);
+}
+.stat-num {
+  font-family: var(--font-display);
+  font-size: clamp(1.9rem, 1.2rem + 2.6vw, 3rem);
+  font-weight: 600;
+  line-height: 1;
+  color: var(--gold);
+  font-variant-numeric: tabular-nums;
+}
+.stat-label {
+  margin-top: 8px;
+  font-size: 0.85rem;
+  color: rgba(251, 247, 239, 0.75);
+}
+
+@media (min-width: 760px) {
+  .stats {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: 16px;
+  }
+  .stat {
+    padding: 22px;
+  }
+}
+@media (min-width: 960px) {
+  .hero-grid {
+    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
+  }
+  .hero-figure {
+    width: min(100%, 440px);
+    margin: 0 0 24px auto;
+  }
+}
+
+/* ── Values strip ───────────────────────────────────────── */
+.values {
+  padding-block: 16px;
+  background: var(--gold-100);
+  border-block: 1px solid #efdcaa;
+}
+.values ul {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 6px 24px;
+}
+.values li {
+  display: inline-flex;
+  align-items: center;
+  gap: 9px;
+  font-size: 0.74rem;
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--teal-900);
+}
+.values li::before {
+  content: '';
+  flex: none;
+  width: 6px;
+  height: 6px;
+  transform: rotate(45deg);
+  background: var(--gold-600);
+}
+
+/* ── Split (image + copy) ───────────────────────────────── */
+.split {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 48px;
+  align-items: center;
+}
+.split-media {
+  position: relative;
+}
+.frame {
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  border-radius: var(--radius-lg);
+  background: var(--paper-2);
+  box-shadow: var(--shadow-md);
+}
+.frame img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.badge-float {
+  position: absolute;
+  right: 14px;
+  bottom: -26px;
+  width: 104px;
+  height: 104px;
+  display: grid;
+  place-content: center;
+  text-align: center;
+  border-radius: 50%;
+  background: var(--gold);
+  color: var(--teal-950);
+  border: 5px solid var(--paper);
+  box-shadow: var(--shadow-md);
+}
+.badge-float strong {
+  font-family: var(--font-display);
+  font-size: 1.6rem;
+  line-height: 1;
+}
+.badge-float span {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.split-copy p:not(.eyebrow) {
+  margin-top: 1em;
+  color: var(--ink-2);
+  font-size: 1.05rem;
+}
+.split-copy .btn {
+  margin-top: 28px;
+}
+@media (min-width: 900px) {
+  .split {
+    grid-template-columns: 1fr 1fr;
+    gap: 80px;
+  }
+  .badge-float {
+    right: -28px;
+  }
+}
+
+/* ── Cards ──────────────────────────────────────────────── */
+.grid-cards {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
+  gap: 16px;
+}
+@media (min-width: 900px) {
+  .grid-cards {
+    gap: 24px;
+  }
+}
+.card {
+  padding: clamp(22px, 3vw, 32px);
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--card);
+  box-shadow: var(--shadow-sm);
+  transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
+}
+.card-icon {
+  width: 54px;
+  height: 54px;
+  display: grid;
+  place-items: center;
+  margin-bottom: 20px;
+  border-radius: 16px;
+  background: var(--gold-100);
+  color: var(--teal-800);
+}
+.card p {
+  margin-top: 10px;
+  color: var(--muted);
+}
+@media (hover: hover) {
+  .card:hover {
+    transform: translateY(-5px);
+    box-shadow: var(--shadow-md);
+    border-color: var(--gold-200);
+  }
+}
+
+/* ── Gallery (bento) ────────────────────────────────────── */
+.bento {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+}
+.tile {
+  position: relative;
+  overflow: hidden;
+  aspect-ratio: 4 / 5;
+  border-radius: 18px;
+  background: var(--teal-800);
+}
+.tile--wide,
+.tile--wide-sm {
+  grid-column: 1 / -1;
+  aspect-ratio: 16 / 10;
+}
+.tile img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transition: transform 0.7s var(--ease);
+}
+.tile figcaption {
+  position: absolute;
+  inset: auto 0 0 0;
+  padding: 40px 16px 14px;
+  background: linear-gradient(to top, rgba(6, 28, 30, 0.8), transparent);
+  color: #fff;
+  font-weight: 600;
+  font-size: 0.95rem;
+}
+@media (hover: hover) {
+  .tile:hover img {
+    transform: scale(1.05);
+  }
+}
+@media (min-width: 900px) {
+  .bento {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    grid-auto-rows: clamp(200px, 20vw, 270px);
+    gap: 16px;
+  }
+  .tile,
+  .tile--wide,
+  .tile--wide-sm {
+    aspect-ratio: auto;
+    grid-column: auto;
+  }
+  .tile--wide {
+    grid-column: span 2;
+  }
+  .tile--tall {
+    grid-column: 3;
+    grid-row: 1 / span 2;
+  }
+  .tile figcaption {
+    padding: 48px 20px 18px;
+  }
+}
+
+/* ── CTA band ───────────────────────────────────────────── */
+.cta {
+  position: relative;
+  overflow: hidden;
+  padding-block: var(--section);
+  text-align: center;
+  color: var(--paper);
+  background-color: var(--teal-900);
+  background-image: radial-gradient(50% 80% at 50% 120%, rgba(242, 105, 44, 0.28), transparent 70%),
+    radial-gradient(40% 60% at 90% 0%, rgba(232, 169, 53, 0.14), transparent 70%);
+}
+.cta h2 {
+  margin-top: 14px;
+  color: var(--paper);
+}
+.cta-text {
+  max-width: 34em;
+  margin: 16px auto 32px;
+  color: rgba(251, 247, 239, 0.8);
+  font-size: 1.08rem;
+}
+
+/* ── Page hero (inner pages) ────────────────────────────── */
+.page-hero {
+  position: relative;
+  overflow: hidden;
+  padding-block: clamp(36px, 6vw, 72px);
+  color: var(--paper);
+  background-color: var(--teal-900);
+  background-image: radial-gradient(50% 90% at 100% 0%, rgba(232, 169, 53, 0.18), transparent 70%),
+    radial-gradient(rgba(251, 247, 239, 0.06) 1px, transparent 1.5px);
+  background-size: auto, 26px 26px;
+}
+.page-hero .eyebrow::before {
+  display: none;
+}
+.page-hero h1 {
+  margin: 12px 0 16px;
+  font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.6rem);
+  color: var(--paper);
+}
+.page-hero .lead {
+  max-width: 36em;
+  color: rgba(251, 247, 239, 0.8);
+}
+.breadcrumb {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-bottom: 22px;
+  font-size: 0.88rem;
+  color: rgba(251, 247, 239, 0.7);
+}
+.breadcrumb a {
+  padding-block: 6px;
+}
+.breadcrumb a:hover {
+  color: var(--gold);
+}
+.breadcrumb [aria-current] {
+  color: var(--paper);
+  font-weight: 600;
+}
+
+/* ── About page ─────────────────────────────────────────── */
+.prose {
+  max-width: 66ch;
+}
+.prose p {
+  margin-top: 1em;
+  color: var(--ink-2);
+  font-size: 1.06rem;
+}
+.about-layout {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 40px;
+  align-items: start;
+}
+.glance {
+  padding: clamp(22px, 3vw, 32px);
+  border-radius: var(--radius-lg);
+  background: var(--teal-900);
+  color: var(--paper);
+}
+.glance h3 {
+  color: var(--paper);
+  margin-bottom: 8px;
+}
+.glance dl > div {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  gap: 16px;
+  padding: 14px 0;
+  border-bottom: 1px solid rgba(251, 247, 239, 0.14);
+}
+.glance dl > div:last-child {
+  border-bottom: 0;
+  padding-bottom: 0;
+}
+.glance dt {
+  font-size: 0.9rem;
+  color: rgba(251, 247, 239, 0.7);
+}
+.glance dd {
+  font-family: var(--font-display);
+  font-size: 1.2rem;
+  font-weight: 600;
+  color: var(--gold);
+  text-align: right;
+}
+.two-col {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 48px;
+}
+.split-sticky {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 8px;
+}
+.timeline {
+  position: relative;
+  padding-left: 30px;
+}
+.timeline::before {
+  content: '';
+  position: absolute;
+  left: 6px;
+  top: 10px;
+  bottom: 10px;
+  width: 2px;
+  border-radius: 2px;
+  background: linear-gradient(to bottom, var(--gold), var(--line));
+}
+.timeline-item {
+  position: relative;
+  padding-bottom: 24px;
+}
+.timeline-item:last-child {
+  padding-bottom: 0;
+}
+.timeline-item::before {
+  content: '';
+  position: absolute;
+  left: -30px;
+  top: 5px;
+  width: 14px;
+  height: 14px;
+  border: 3px solid var(--paper-2);
+  border-radius: 50%;
+  background: var(--gold);
+  box-shadow: 0 0 0 2px var(--gold);
+}
+.timeline-year {
+  display: inline-block;
+  margin-bottom: 8px;
+  font-family: var(--font-display);
+  font-size: 1.5rem;
+  font-weight: 700;
+  line-height: 1;
+  color: var(--teal-700);
+}
+.timeline-card {
+  padding: 20px 22px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--card);
+  box-shadow: var(--shadow-sm);
+}
+.timeline-card p {
+  margin-top: 8px;
+  color: var(--muted);
+}
+@media (min-width: 900px) {
+  .about-layout {
+    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
+    gap: 72px;
+  }
+  .glance {
+    position: sticky;
+    top: calc(var(--header-h) + 24px);
+  }
+  .two-col {
+    grid-template-columns: 1fr 1fr;
+    gap: 72px;
+  }
+  .split-sticky {
+    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
+    gap: 72px;
+  }
+  .split-sticky .section-head {
+    position: sticky;
+    top: calc(var(--header-h) + 32px);
+    align-self: start;
+  }
+}
+
+/* ── Contact page ───────────────────────────────────────── */
+.contact-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 32px;
+  align-items: start;
+}
+.contact-grid .muted {
+  margin-top: 14px;
+  font-size: 1.05rem;
+}
+.info-list {
+  display: grid;
+  gap: 12px;
+  margin-top: 28px;
+}
+.info-item {
+  display: flex;
+  gap: 16px;
+  align-items: flex-start;
+  padding: 18px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: var(--card);
+}
+.info-icon {
+  flex: none;
+  width: 48px;
+  height: 48px;
+  display: grid;
+  place-items: center;
+  border-radius: 14px;
+  background: var(--gold-100);
+  color: var(--teal-800);
+}
+.info-item h3 {
+  margin-bottom: 2px;
+  font-family: var(--font-body);
+  font-size: 0.74rem;
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--muted);
+}
+.info-item p,
+.info-item a {
+  color: var(--ink);
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+.info-item a {
+  display: inline-block;
+  padding-block: 2px;
+  border-bottom: 2px solid var(--gold-200);
+  transition: border-color 0.2s;
+}
+.info-item a:hover {
+  border-color: var(--gold);
+}
+.lk-card .btn {
+  margin-top: 24px;
+}
+.lk-frame {
+  display: none;
+  width: 100%;
+  height: 480px;
+  margin-top: 24px;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-sm);
+  background: #fff;
+}
+@media (min-width: 900px) {
+  .contact-grid {
+    grid-template-columns: 1fr 1fr;
+    gap: 56px;
+  }
+  .lk-frame {
+    display: block;
+  }
+  .lk-link {
+    display: none;
+  }
+}
+.map {
+  aspect-ratio: 4 / 3;
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-lg);
+  background: var(--paper-2);
+  box-shadow: var(--shadow-sm);
+}
+.map iframe {
+  display: block;
+  width: 100%;
+  height: 100%;
+  border: 0;
+}
+@media (min-width: 760px) {
+  .map {
+    aspect-ratio: 16 / 7;
+  }
+}
+
+/* ── Social icons ───────────────────────────────────────── */
+.social-row {
+  display: flex;
+  gap: 10px;
+  margin-top: 24px;
+}
+.social-row a {
+  width: 46px;
+  height: 46px;
+  display: grid;
+  place-items: center;
+  border: 1px solid rgba(251, 247, 239, 0.25);
+  border-radius: 50%;
+  color: var(--paper);
+  transition: background-color 0.2s, color 0.2s, border-color 0.2s;
+}
+.social-row a:hover {
+  background: var(--gold);
+  border-color: var(--gold);
+  color: var(--teal-950);
+}
+.social-row--dark a {
+  border-color: var(--line);
+  color: var(--teal-900);
+}
+
+/* ── Footer ─────────────────────────────────────────────── */
+.site-footer {
+  flex: none;
+  padding-top: clamp(48px, 7vw, 80px);
+  background: var(--teal-950);
+  color: rgba(251, 247, 239, 0.78);
+}
+.footer-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 40px;
+}
+.brand--light .brand-mark {
+  background: rgba(251, 247, 239, 0.1);
+}
+.brand--light .brand-name {
+  color: var(--paper);
+}
+.brand--light .brand-sub {
+  display: block;
+  color: rgba(251, 247, 239, 0.65);
+}
+.footer-brand p {
+  max-width: 30em;
+  margin-top: 20px;
+}
+.footer-col h2 {
+  margin-bottom: 14px;
+  font-family: var(--font-body);
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  text-transform: uppercase;
+  color: var(--gold);
+}
+.footer-col a {
+  display: inline-block;
+  padding-block: 6px;
+  transition: color 0.2s;
+}
+.footer-col a:hover {
+  color: var(--gold);
+}
+.footer-contact li {
+  display: flex;
+  gap: 12px;
+  align-items: flex-start;
+  padding-block: 6px;
+}
+.footer-contact .icon {
+  margin-top: 4px;
+  color: var(--gold);
+}
+.footer-contact a {
+  padding-block: 0;
+  overflow-wrap: anywhere;
+}
+.footer-bottom {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: 8px 24px;
+  margin-top: 48px;
+  padding: 20px 0 calc(24px + env(safe-area-inset-bottom));
+  border-top: 1px solid rgba(251, 247, 239, 0.12);
+  font-size: 0.85rem;
+  color: rgba(251, 247, 239, 0.6);
+}
+.made-by {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+.made-by strong {
+  color: var(--paper);
+}
+.heart {
+  color: #ff5a4d;
+  fill: currentColor;
+}
+@media (min-width: 760px) {
+  .footer-grid {
+    grid-template-columns: 1.5fr 1fr 1.3fr;
+    gap: 56px;
+  }
+}
+
+/* ── 404 ────────────────────────────────────────────────── */
+.notfound {
+  display: grid;
+  place-items: center;
+  min-height: calc(100vh - var(--header-h));
+  min-height: calc(100dvh - var(--header-h));
+  padding-block: 64px;
+  text-align: center;
+}
+.notfound-lamp .flame {
+  width: 34px;
+  height: 48px;
+  margin: 0 auto;
+  opacity: 0.85;
+}
+.notfound-code {
+  margin-top: 12px;
+  font-family: var(--font-display);
+  font-size: clamp(5rem, 3rem + 14vw, 10rem);
+  font-weight: 700;
+  line-height: 1;
+  color: var(--gold);
+}
+.notfound h1 {
+  margin-top: 4px;
+  font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
+}
+.notfound .lead {
+  max-width: 30em;
+  margin: 16px auto 32px;
+  color: var(--muted);
+}
+
+/* ── Motion & print preferences ─────────────────────────── */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+  .js [data-reveal] {
+    opacity: 1;
+    translate: none;
+  }
+}
+@media print {
+  .site-header,
+  .progress,
+  .skip-link,
+  .hero-glow {
+    display: none !important;
+  }
+  .js [data-reveal] {
+    opacity: 1;
+    translate: none;
+  }
+}
